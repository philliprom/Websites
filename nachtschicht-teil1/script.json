      "gap": 0.0,
      "sfx": []
    },
    {
      "id": "s02",
      "say": "Acht Minuten vorher.",
      "caps": [
        "ACHT MINUTEN VORHER."
      ],
      "gap": 0.7,
      "sfx": []
    },
    {
      "id": "s03",
      "say": "Du hast Nachtschicht an einer Tankstelle. Irgendwo an der Landstraße. Du bist allein.",
