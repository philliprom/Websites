  "segments": [
    {"id": "s01", "say": "Tag eins.", "caps": ["TAG ^EINS."], "gap": 0.0, "sfx": [["title", 0.0]]},
    {"id": "s02", "say": "Das ist meine Oma Gisela.", "caps": ["DAS IST MEINE", "OMA ^GISELA."], "sfx": [["whoosh", -0.05], ["pop", 0.08]]},
    {"id": "s03", "say": "Sie ist achtundsiebzig und fliegt zum Mond.", "caps": ["SIE IST 78", "UND FLIEGT ZUM ^MOND."], "sfx": [["stamp", "e-0.35"], ["confetti", "e-0.3"]]},
    {"id": "s04", "say": "Jeder neue Folloher", "caps": ["JEDER NEUE ^FOLLOWER"], "sfx": [["whoosh", -0.05], ["pop", 0.05]]},
    {"id": "s05", "say": "bringt ihre Rakete einen Meter höher.", "caps": ["BRINGT IHRE RAKETE", "EINEN ^METER ^HÖHER."], "sfx": [["ding", 0.15], ["rocket", 0.35], ["pop", 0.6]]},
    {"id": "s06", "say": "Willkommen bei Omas Mondmission!", "caps": ["WILLKOMMEN BEI", "^OMAS ^MONDMISSION!"], "sfx": [["whoosh", -0.05], ["sparkle", 0.1]]},
    {"id": "s07", "say": "Die Rakete: eine Regentonne.", "caps": ["DIE RAKETE:", "EINE ^REGENTONNE."], "sfx": [["pop", 0.08]]},
    {"id": "s08", "say": "Die Spitze: ein Trichter.", "caps": ["DIE SPITZE:", "EIN ^TRICHTER."], "sfx": [["pop", 0.08]]},
    {"id": "s09", "say": "Der Treibstoff: Sprudel.", "caps": ["DER TREIBSTOFF:", "!SPRUDEL."], "sfx": [["pop", 0.08]]},
    {"id": "s10", "say": "Aktuelle Höhe: null Meter.", "caps": ["AKTUELLE HÖHE:", "!NULL !METER."], "gap": 0.3, "sfx": [["crickets", 0.3]]},
    {"id": "s11", "say": "Und die Crew?", "caps": ["UND DIE ~CREW?"], "gap": 0.35, "sfx": [["pop", 0.08]]},
    {"id": "s12", "say": "Kopilot Waldi.", "caps": ["KOPILOT ^WALDI."], "sfx": [["pop", 0.1], ["bark", 0.55]]},
    {"id": "s13", "say": "Bezahlung: eine Leberwurst am Tag.", "caps": ["BEZAHLUNG: EINE", "^LEBERWURST", "AM TAG."], "sfx": [["pop", 0.08], ["crunch", "e-0.2"]]},
    {"id": "s14", "say": "Und er bellt bei jedem Kauntdaun.", "caps": ["UND ER !BELLT", "BEI JEDEM COUNTDOWN."], "sfx": [["beep", 0.1], ["beep", 0.55], ["bark", 1.0]]},
    {"id": "s15", "say": "Heute: der Schrebergarten.", "caps": ["HEUTE: DER", "^SCHREBERGARTEN."], "gap": 0.25, "sfx": [["whoosh", -0.05], ["pop", 0.1]]},
    {"id": "s16", "say": "Irgendwann: der Mond.", "caps": ["IRGENDWANN:", "DER ^MOND."], "sfx": [["riser", 0.0], ["rocket", 0.25], ["pins", 0.7]]},
    {"id": "s17", "say": "Morgen früh ist der erste Kauntdaun.", "caps": ["MORGEN FRÜH IST", "DER ERSTE ^COUNTDOWN."], "gap": 0.2, "sfx": [["whoosh", -0.05], ["pop", 0.1]]},
    {"id": "s18", "say": "Und die Zuschauer?", "caps": ["UND DIE ~ZUSCHAUER?"], "sfx": [["pop", 0.08]]},
    {"id": "s19", "say": "Nur ein Gartenzwerg.", "caps": ["NUR EIN", "!GARTENZWERG."], "sfx": [["crickets", 0.1], ["pop", 0.45]]},
    {"id": "s20", "say": "Also folg jetzt.", "caps": ["ALSO ^FOLG ^JETZT."], "gap": 0.3, "sfx": [["whoosh", -0.05], ["tap", 0.62], ["ding", 0.66]]},
    {"id": "s21", "say": "Wer heute kommentiert,", "caps": ["WER HEUTE", "^KOMMENTIERT,"], "sfx": [["blip", 0.1]]},
    {"id": "s22", "say": "kommt mit seinem Namen auf die Rakete.", "caps": ["KOMMT MIT SEINEM", "^NAMEN AUF DIE ^RAKETE."], "sfx": [["pop", 0.05], ["stamp", "e-0.3"]]},
    {"id": "s23", "say": "Aber nur heute.", "caps": ["ABER !NUR !HEUTE."], "sfx": [["tick", 0.1], ["tick", 0.4], ["tick", 0.7]]},
    {"id": "s24", "say": "Ab jetzt bestimmt ihr.", "caps": ["AB JETZT", "^BESTIMMT ^IHR."], "gap": 0.25, "sfx": [["pop", 0.05], ["blip", 0.35], ["blip", 0.6], ["blip", 0.85]]},
    {"id": "s25", "say": "In Omas Sparschwein:", "caps": ["IN OMAS", "SPARSCHWEIN:"], "sfx": [["whoosh", -0.05], ["pop", 0.08]]},
    {"id": "s26", "say": "fünfhundert Euro.", "caps": ["^500 ^EURO."], "sfx": [["kaching", 0.05]]},
    {"id": "s27", "say": "Ein Fallschirm, falls was schiefgeht?", "caps": ["EIN ^FALLSCHIRM,", "FALLS WAS SCHIEFGEHT?"], "gap": 0.2, "sfx": [["whoosh", -0.05], ["card", 0.05]]},
    {"id": "s28", "say": "Ein Raumhelm für Waldi?", "caps": ["EIN ^RAUMHELM", "FÜR WALDI?"], "sfx": [["card", 0.05], ["bark", "e-0.1"]]},
    {"id": "s29", "say": "Oder ganz was anderes?", "caps": ["ODER GANZ", "WAS ^ANDERES?"], "sfx": [["card", 0.05]]},
    {"id": "s30", "say": "Was die meisten Leiks hat, machen wir.", "caps": ["WAS DIE MEISTEN", "^LIKES HAT,", "^MACHEN ^WIR."], "sfx": [["pop", 0.05], ["hearts", 0.3], ["hearts", 1.2], ["ding", 2.0]]}
  ]
