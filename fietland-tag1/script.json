  "segments": [
    {"id": "s01", "say": "Tag eins.", "caps": ["TAG ^EINS."], "gap": 0.0,
     "sfx": [["title", 0.0]]},
    {"id": "s02", "say": "Ich bin Fiete,", "caps": ["ICH BIN ^FIETE,"],
     "sfx": [["whoosh", -0.05], ["pop", 0.08]]},
    {"id": "s03", "say": "und ich habe mein eigenes Land gegründet.", "caps": ["UND ICH HABE MEIN", "EIGENES ^LAND ^GEGRÜNDET."],
     "sfx": [["stamp", 1.05], ["confetti", 1.1]]},
    {"id": "s04", "say": "Jeder neue Folloher", "caps": ["JEDER NEUE ^FOLLOWER"],
     "sfx": [["whoosh", -0.05], ["pop", 0.05]]},
    {"id": "s05", "say": "wird ein Einwohner", "caps": ["WIRD EIN ^EINWOHNER"],
     "sfx": [["ding", 0.15], ["pop", 0.45]]},
    {"id": "s06", "say": "und zieht hier ein.", "caps": ["UND ZIEHT ^HIER EIN."],
     "sfx": [["pop", 0.08]]},
    {"id": "s07", "say": "Willkommen in Fietland!", "caps": ["WILLKOMMEN IN", "^FIETLAND!"],
     "sfx": [["whoosh", -0.05], ["sparkle", 0.1]]},
    {"id": "s08", "say": "Eine Sandbank in der Nordsee.", "caps": ["EINE ^SANDBANK", "IN DER NORDSEE."],
     "sfx": [["pop", 0.08]]},
    {"id": "s09", "say": "Bei Flut: vier Quadratmeter.", "caps": ["BEI !FLUT:", "VIER QUADRATMETER."],
     "sfx": [["splash", 0.05], ["pop", 0.1]]},
    {"id": "s10", "say": "Eine Palme. Aus Plastik.", "caps": ["EINE ^PALME.", "AUS !PLASTIK."],
     "sfx": [["pop", 0.08], ["pop", 0.75]]},
    {"id": "s11", "say": "Ein Strandkorb.", "caps": ["EIN ^STRANDKORB."],
     "sfx": [["pop", 0.08]]},
    {"id": "s12", "say": "Einwohner: null.", "caps": ["EINWOHNER: !NULL."], "gap": 0.3,
     "sfx": [["waves", 0.0]]},
    {"id": "s13", "say": "Meine Regierung?", "caps": ["MEINE ~REGIERUNG?"], "gap": 0.35,
     "sfx": [["pop", 0.08]]},
    {"id": "s14", "say": "Finanzminister Jürgen.", "caps": ["FINANZMINISTER", "^JÜRGEN."],
     "sfx": [["flap", 0.0], ["squawk", 0.55], ["pop", 0.1]]},
    {"id": "s15", "say": "Gehalt: ein Fischbrötchen am Tag.", "caps": ["GEHALT: EIN", "^FISCHBRÖTCHEN", "AM TAG."],
     "sfx": [["pop", 0.08], ["gulp", 1.55]]},
    {"id": "s16", "say": "Und er klaut alles, was glänzt.", "caps": ["UND ER !KLAUT", "ALLES, WAS GLÄNZT."],
     "sfx": [["poof", 0.45], ["squawk", 0.75]]},
    {"id": "s17", "say": "Heute: eine Sandbank.", "caps": ["HEUTE: EINE", "^SANDBANK."], "gap": 0.2,
     "sfx": [["whoosh", -0.05], ["pop", 0.1]]},
    {"id": "s18", "say": "Irgendwann: auf jeder Weltkarte.", "caps": ["IRGENDWANN: AUF", "JEDER ^WELTKARTE."],
     "sfx": [["riser", 0.0], ["pins", 0.5]]},
    {"id": "s19", "say": "Morgen früh legt hier die erste Fähre an.", "caps": ["MORGEN FRÜH LEGT", "HIER DIE ERSTE", "^FÄHRE AN."], "gap": 0.2,
     "sfx": [["whoosh", -0.05], ["horn", 0.35], ["pop", 0.1]]},
    {"id": "s20", "say": "Und an Bord?", "caps": ["UND AN ~BORD?"],
     "sfx": [["pop", 0.08]]},
    {"id": "s21", "say": "Kein einziger Mensch.", "caps": ["KEIN EINZIGER", "!MENSCH."],
     "sfx": [["squeak", 0.55]]},
    {"id": "s22", "say": "Also folg jetzt.", "caps": ["ALSO ^FOLG ^JETZT."], "gap": 0.3,
     "sfx": [["whoosh", -0.05], ["tap", 0.62], ["ding", 0.66]]},
    {"id": "s23", "say": "Wer heute kommentiert,", "caps": ["WER HEUTE", "^KOMMENTIERT,"],
     "sfx": [["blip", 0.1]]},
    {"id": "s24", "say": "bekommt den Gründer-Reisepass.", "caps": ["BEKOMMT DEN", "^GRÜNDER-REISEPASS."],
     "sfx": [["pop", 0.05], ["stamp", 0.95]]},
    {"id": "s25", "say": "Den gibt's nur heute.", "caps": ["DEN GIBT'S", "!NUR !HEUTE."],
     "sfx": [["tick", 0.1], ["tick", 0.45], ["tick", 0.8]]},
    {"id": "s26", "say": "Morgen stehst du dann ganz oben auf der Einwohnerliste.", "caps": ["MORGEN STEHST ^DU", "DANN GANZ ^OBEN", "AUF DER ^EINWOHNERLISTE."],
     "sfx": [["whoosh", -0.05], ["sparkle", 0.9]]},
    {"id": "s27", "say": "Ab jetzt bestimmt ihr.", "caps": ["AB JETZT", "^BESTIMMT ^IHR."], "gap": 0.25,
     "sfx": [["pop", 0.05], ["blip", 0.35], ["blip", 0.6], ["blip", 0.85]]},
    {"id": "s28", "say": "In der Staatskasse:", "caps": ["IN DER", "STAATSKASSE:"],
     "sfx": [["whoosh", -0.05], ["pop", 0.08]]},
    {"id": "s29", "say": "fünfhundert Euro.", "caps": ["^500 ^EURO."],
     "sfx": [["kaching", 0.05]]},
    {"id": "s30", "say": "Eine Flagge, damit man uns überhaupt findet?", "caps": ["EINE ^FLAGGE,", "DAMIT MAN UNS", "ÜBERHAUPT FINDET?"], "gap": 0.2,
     "sfx": [["whoosh", -0.05], ["card", 0.05]]},
    {"id": "s31", "say": "Einen eigenen Strandkorb für Jürgen?", "caps": ["EINEN EIGENEN", "^STRANDKORB", "FÜR JÜRGEN?"],
     "sfx": [["card", 0.05], ["squawk", 1.3]]},
    {"id": "s32", "say": "Oder ganz was anderes?", "caps": ["ODER GANZ", "WAS ^ANDERES?"],
     "sfx": [["card", 0.05]]},
    {"id": "s33", "say": "Was die meisten Leiks hat, machen wir.", "caps": ["WAS DIE MEISTEN", "^LIKES HAT,", "^MACHEN ^WIR."],
     "sfx": [["pop", 0.05], ["hearts", 0.3], ["hearts", 1.2], ["ding", 2.0]]}
